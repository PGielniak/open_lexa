# dual | openai | http
# dual: every recording goes to the local Whisper API and cloud GPT transcribe
# in parallel. The GPT text is the automatically corrected transcript in admin.
# Without STT_BACKEND, dual is selected automatically when both STT_HTTP_URL
# and OPENAI_API_KEY are set; otherwise the legacy openai backend is used.
STT_BACKEND=dual
STT_LANGUAGE=pl

# Local Whisper API used by dual (and by STT_BACKEND=http):
STT_HTTP_URL=http://open-lexa-whisper:8080/v1
STT_HTTP_MODEL=whisper-1
# STT_HTTP_API_KEY=not-needed

# Cloud GPT transcription used by dual (and by STT_BACKEND=openai):
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-transcribe
# OPENAI_BASE_URL=https://api.openai.com/v1

# STT_BACKEND=http alone: any OpenAI-compatible /v1/audio/transcriptions
# endpoint. "local" remains accepted as a backwards-compatible alias.
# STT_HTTP_URL=https://provider.example/v1
# STT_HTTP_MODEL=provider-model

# Optional SMB archive of every recording (.wav) + transcripts (.json) for retraining.
# Files land in \\SMB_SERVER\SMB_SHARE\SMB_PATH\YYYY-MM-DD\.
# SMB_SERVER=nas.local
# SMB_SHARE=data
# SMB_PATH=open-lexa
# SMB_USERNAME=
# SMB_PASSWORD=
# SMB_TIMEOUT=10
# With SMB, the receiver also polls _config/stt.json (STT settings saved in the
# admin UI) and prefers it over the STT_* variables above; 0 disables polling.
# OPEN_LEXA_SETTINGS_SECONDS=30

# 32 hex characters; identical to RECEIVER_TOKEN in the firmware Config.h.
OPEN_LEXA_TOKEN=replace-with-the-same-32-hex-characters-as-firmware
